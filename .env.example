# Copie para .env.local (desenvolvimento) — nunca commite ficheiros .env*.
#
# --- Desenvolvimento local ---
# Não precisa definir REACT_APP_* — o CRA usa proxy (setupProxy.js):
#   /api, /auth → localhost:8080
#
# Opcional (evita conflito HMR com SockJS):
# WDS_SOCKET_PATH=/webpack-hmr

# --- Produção (Vercel) ---
# Importe o ficheiro vercel.env no painel do Vercel (Environment → Import .env).
# NÃO defina REACT_APP_API_URL — o vercel.json faz proxy.

REACT_APP_API_WAKE_URL=https://poketeamguess-backend.onrender.com
REACT_APP_API_COLD_START_AVERAGE_SECONDS=50

# Forçar página de cold start em dev (npm start) para testar:
# REACT_APP_ENABLE_API_HEALTH_CHECK=true
