# Copie para .env.development.local (opcional) — nunca commite.
#
# Desenvolvimento local: não precisa de REACT_APP_* — o proxy aponta para localhost:8080.
# Socket.io em dev: setupProxy.js encaminha /socket.io → localhost:9092 (servidor netty-socketio).
#
# WDS_SOCKET_PATH=/webpack-hmr
#
# --- Socket.io (opcional em dev; em produção use a mesma origem do site) ---
# REACT_APP_SOCKET_URL=
#
# --- Produção (Vercel) — ver vercel.env ---
