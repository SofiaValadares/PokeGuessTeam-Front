# Copie para .env.local (desenvolvimento) — nunca commite ficheiros .env*.
#
# --- Desenvolvimento local ---
# Não precisa definir REACT_APP_* — o CRA usa proxy (setupProxy.js):
#   /api, /auth → localhost:8080
#   /socket.io  → localhost:9092
#
# Opcional (evita conflito HMR com SockJS):
# WDS_SOCKET_PATH=/webpack-hmr

# --- Produção (Vercel) ---
# Deixe REACT_APP_API_URL e REACT_APP_SOCKET_URL VAZIOS.
# O vercel.json faz proxy para o backend Render (mesmo domínio = cookies OK).
# Edite vercel.json com a URL real do seu Web Service no Render.

# REACT_APP_API_URL=
# REACT_APP_SOCKET_URL=

# URL direta do Render para “acordar” a API (health check + cold start).
# Ex.: https://poketeamguess-backend.onrender.com
# REACT_APP_API_WAKE_URL=

# Tempo médio exibido na página “API a acordar” (segundos; default 50)
# REACT_APP_API_COLD_START_AVERAGE_SECONDS=50

# Forçar página de cold start em dev (npm start) para testar
# REACT_APP_ENABLE_API_HEALTH_CHECK=true
