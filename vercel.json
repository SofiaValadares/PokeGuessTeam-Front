{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://poketeamguess-backend.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://poketeamguess-backend.onrender.com/auth/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://poketeamguess-backend.onrender.com/socket.io/:path*"
    }
  ]
}
